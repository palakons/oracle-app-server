[Unit]
Description=Thai Unified Toll Map Application Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/thai_unified_toll_map
EnvironmentFile=/var/www/thai_unified_toll_map/.env
Environment=PORT=3001
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
