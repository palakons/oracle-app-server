[Unit]
Description=Alpha Trader v2 Python Backend Service
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/alpha-trader-v2
EnvironmentFile=/var/www/alpha-trader-v2/backend/.env
Environment=PORT=8000
ExecStart=/var/www/alpha-trader-v2/venv/bin/uvicorn backend.app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
