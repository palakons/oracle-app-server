[Unit]
Description=Alpha Trader Next.js Dashboard UI
After=network.target alpha-trader-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/alpha-trader-v2/frontend
Environment=PORT=3000 NODE_ENV=production
EnvironmentFile=-/var/www/alpha-trader-v2/frontend/.env.production
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
ProtectSystem=full
NoNewPrivileges=true
ProtectHome=read-only
ReadWritePaths=/var/www /tmp

[Install]
WantedBy=multi-user.target
